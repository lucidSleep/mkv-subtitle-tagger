#!/bin/sh
# Linux / macOS launcher for fix_subs.py (needs Python 3.9+ and MKVToolNix). Usage: README.md.
#   ./fix-subs "<folder or .mkv>"           dry run: what it found + simulated result, writes nothing
#   ./fix-subs "<folder or .mkv>" --apply   writes the tags (reuses the dry run's plan if files are unchanged)
# -I = isolated mode (the subtitle text comes from outside), -X utf8 = UTF-8 output whatever the locale.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 -I -X utf8 "$script_dir/fix_subs.py" "$@"
